---
import Foto from '../Foto.astro';
const { b } = Astro.props;
const items = (b.items ?? []) as { nama: string; keterangan?: string; foto?: string; kutipan: string }[];
---
{items.length > 0 && (
<section class="section"><div class="wrap">
  {b.judul && <div class="section-head"><h2>{b.judul}</h2></div>}
  <div class="testi" tabindex="0" aria-label="Testimoni petani, geser untuk melihat lainnya">
    {items.map((t) => (
      <figure class="testi__item">
        <blockquote>{t.kutipan}</blockquote>
        <figcaption>
          <span class="testi__foto"><Foto src={t.foto} alt={`Foto ${t.nama}`} label={t.nama.slice(0, 1)} /></span>
          <span><strong>{t.nama}</strong>{t.keterangan && <span>{t.keterangan}</span>}</span>
        </figcaption>
      </figure>
    ))}
  </div>
</div></section>
)}
