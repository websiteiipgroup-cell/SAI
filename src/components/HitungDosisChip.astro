---
// "Hitung dosis" entry point placed at the end of the crop chip rows. Shown only while the calculator is switched on.
import kalk from '../data/kalkulator.json';
const { produk } = Astro.props;
const aktif = (kalk as any).aktif === true;
---
{aktif && (
  <a class="chip chip--hitung" href={produk ? `/hitung-dosis/?produk=${produk}` : '/hitung-dosis/'}>
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><path d="M8 7h8M8 12h2M14 12h2M8 16h2M14 16h2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    Hitung dosis
  </a>
)}
