---
// Swipeable photo album (like an Instagram carousel). Works by native swipe / scroll-snap;
// the buttons and counter are added on top and degrade to a plain scroll strip without JS.
interface Props { foto: { gambar: string; keterangan?: string }[]; judul: string; }
const { foto, judul } = Astro.props;
---
<div class="album" data-album role="region" aria-roledescription="album foto" aria-label={`Album foto: ${judul}`}>
  <div class="album__track" tabindex="0">
    {foto.map((f, i) => (
      <figure class="album__slide" aria-label={`Foto ${i + 1} dari ${foto.length}`}>
        <img src={f.gambar} alt={f.keterangan || `Foto ${i + 1}, ${judul}`} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
        {f.keterangan && <figcaption>{f.keterangan}</figcaption>}
      </figure>
    ))}
  </div>
  {foto.length > 1 && (
    <div class="album__kontrol">
      <button type="button" class="album__btn" data-arah="-1" aria-label="Foto sebelumnya">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <span class="album__hitung" aria-live="polite"><span data-ke>1</span> / {foto.length}</span>
      <button type="button" class="album__btn" data-arah="1" aria-label="Foto berikutnya">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
  )}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-album]').forEach((album) => {
    const track = album.querySelector<HTMLElement>('.album__track')!;
    const slides = [...track.children] as HTMLElement[];
    const ke = album.querySelector('[data-ke]');
    const [prev, next] = album.querySelectorAll<HTMLButtonElement>('.album__btn');
    const index = () => Math.round(track.scrollLeft / track.clientWidth);
    const go = (i: number) => {
      const t = Math.max(0, Math.min(slides.length - 1, i));
      track.scrollTo({ left: t * track.clientWidth, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    };
    const update = () => {
      const i = index();
      if (ke) ke.textContent = String(i + 1);
      if (prev) prev.disabled = i === 0;
      if (next) next.disabled = i === slides.length - 1;
    };
    album.querySelectorAll<HTMLButtonElement>('.album__btn').forEach((b) =>
      b.addEventListener('click', () => go(index() + Number(b.dataset.arah))));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); go(index() + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(index() - 1); }
    });
    let t: number | undefined;
    track.addEventListener('scroll', () => { clearTimeout(t); t = window.setTimeout(update, 60); }, { passive: true });
    window.addEventListener('resize', () => go(index()));
    update();
  });
</script>
