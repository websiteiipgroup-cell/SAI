---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArtikelCard from '../components/ArtikelCard.astro';
import Foto from '../components/Foto.astro';
import site from '../data/site.json';
import { slugify } from '../lib/md';
const list = (await getCollection('artikel', (a) => !a.data.draft && a.data.kategori === 'Cerita Sagri'))
  .sort((a, b) => b.data.tanggal.valueOf() - a.data.tanggal.valueOf());
---
<Base title="Cerita Sagri" description={site.cerita_pengantar}>
  <section class="page-head"><div class="wrap"><p class="breadcrumb"><a href="/kabar/">Kabar</a></p><h1>Cerita Sagri</h1><p>{site.cerita_pengantar}</p></div></section>
  <section class="section"><div class="wrap">
    <div class="kegiatan">
      {site.kegiatan.map((k) => {
        const n = list.filter((a) => a.data.kegiatan === k.nama).length;
        return (
          <div class="kegiatan__item" id={slugify(k.nama)}>
            <div class="kegiatan__foto"><Foto src={k.gambar} alt={k.nama} label={k.nama} /></div>
            <h2>{k.nama} <span class="kegiatan__singkat">({k.singkatan})</span></h2>
            <p>{k.deskripsi}</p>
            <p class="kegiatan__jumlah">{n > 0 ? `${n} cerita` : 'Belum ada cerita'}</p>
          </div>
        );
      })}
    </div>
  </div></section>
  <section class="section band"><div class="wrap">
    <div class="section-head"><h2>Cerita terbaru</h2></div>
    {list.length === 0
      ? <p class="lead">Belum ada cerita. Tambahkan lewat admin, menu Artikel.</p>
      : <div class="agrid">{list.map((a) => <ArtikelCard a={a} ringkas />)}</div>}
  </div></section>
</Base>
