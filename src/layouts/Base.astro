---
import '../styles/global.css';
import site from '../data/site.json';
import { tel, wa, slugify } from '../lib/md';

interface Props { title?: string; description?: string; image?: string; }
const { title, description = site.deskripsi, image = site.og_image } = Astro.props;
const fullTitle = title ? `${title} | ${site.nama_merek}` : `${site.nama_merek}, ${site.tagline} | ${site.nama_perusahaan}`;
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const schema = {
  '@context': 'https://schema.org', '@type': 'Organization',
  name: site.nama_perusahaan, brand: site.nama_merek, url: Astro.site?.href, logo: site.logo ? new URL(site.logo, Astro.site).href : undefined,
  email: site.email, telephone: site.telepon, address: site.alamat,
  sameAs: [site.instagram, site.facebook, site.tiktok, site.youtube].filter(Boolean),
};
---
<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={new URL(path, Astro.site)}>
  <meta property="og:type" content="website">
  <meta property="og:locale" content="id_ID">
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={new URL(image || '/favicon.png', Astro.site)}>
  <meta property="og:url" content={new URL(path, Astro.site)}>
  <meta name="theme-color" content="#1f4d2b">
  <link rel="icon" href={site.ikon || '/favicon.png'}>
  <link rel="apple-touch-icon" href={site.ikon || '/favicon.png'}>
  <link rel="preload" href="/fonts/jakarta-latin.woff2" as="font" type="font/woff2" crossorigin>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</head>
<body>
  <a class="skip" href="#main">Langsung ke isi</a>

  <header class="masthead">
    <div class="wrap masthead__inner">
      <a class="brand" href="/" aria-label={`${site.nama_perusahaan}, ke beranda`}>
        {site.logo ? <img src={site.logo} alt={site.nama_perusahaan} width="94" height="52" /> : <span class="brand__teks">{site.nama_merek}</span>}
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <span>Menu</span>
      </button>
      <nav id="site-nav" class="nav" aria-label="Menu utama">
        <ul>
          {site.menu.map((n) => <li><a href={n.link} aria-current={isCurrent(n.link) ? 'page' : undefined}>{n.label}</a></li>)}
        </ul>
        <a class="btn btn--wa nav__wa" href={wa('Halo SAGRI, saya ingin bertanya.')}>Tanya via WhatsApp</a>
      </nav>
    </div>
  </header>

  <main id="main"><slot /></main>

  <footer class="footer">
    <div class="wrap footer__grid">
      <div class="footer__merek">
        {site.logo_putih ? <img src={site.logo_putih} alt={site.nama_perusahaan} width="150" height="85" loading="lazy" /> : <p class="footer__nama">{site.nama_merek}</p>}
        <p>{site.tagline}</p>
      </div>
      <nav aria-label="Produk">
        <p class="footer__judul">Produk</p>
        <ul>
          {site.jenis.map((j) => <li><a href={`/produk/#${slugify(j.nama)}`}>{j.judul}</a></li>)}
        </ul>
      </nav>
      <nav aria-label="Solusi tanaman">
        <p class="footer__judul">Solusi tanaman</p>
        <ul>
          {site.komoditas.map((k) => <li><a href={`/solusi/${k.slug}/`}>{k.nama}</a></li>)}
        </ul>
      </nav>
      <div>
        <p class="footer__judul">{site.nama_perusahaan}</p>
        <address>
          {site.alamat}<br>
          <a href={tel(site.telepon)}>{site.telepon}</a><br>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </address>
        <p class="footer__sosmed">
          {site.instagram && <a href={site.instagram}>Instagram</a>}
          {site.facebook && <a href={site.facebook}>Facebook</a>}
          {site.tiktok && <a href={site.tiktok}>TikTok</a>}
          {site.youtube && <a href={site.youtube}>YouTube</a>}
        </p>
      </div>
    </div>
    <div class="wrap footer__bawah">
      <span>© {new Date().getFullYear()} {site.nama_perusahaan}</span>
      <span>Baca dan ikuti petunjuk pada label kemasan sebelum memakai pestisida.</span>
    </div>
  </footer>

  {site.whatsapp && (
    <a class="wa-float" href={wa('Halo SAGRI, saya ingin bertanya.')} aria-label="Chat WhatsApp dengan tim SAGRI">
      <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true"><path fill="currentColor" d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3Zm0 23.7a10.7 10.7 0 0 1-5.5-1.5l-.4-.2-3.9 1 1-3.8-.3-.4A10.7 10.7 0 1 1 16 26.7Zm5.9-8c-.3-.2-1.9-1-2.2-1.1-.3-.1-.5-.2-.7.2l-1 1.2c-.2.2-.4.2-.7.1a8.8 8.8 0 0 1-4.4-3.8c-.3-.6.3-.5.9-1.7.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6a1.2 1.2 0 0 0-.9.4 3.6 3.6 0 0 0-1.1 2.7 6.3 6.3 0 0 0 1.3 3.3 14.4 14.4 0 0 0 5.5 4.9c2 .9 2.9 1 3.9.8a3.3 3.3 0 0 0 2.2-1.5 2.7 2.7 0 0 0 .2-1.5c-.1-.2-.3-.3-.6-.4Z"/></svg>
      <span>Tanya SAGRI</span>
    </a>
  )}

  <script>
    const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const nav = document.getElementById('site-nav');
    const label = toggle?.querySelector('span');
    const setOpen = (open: boolean) => {
      nav?.classList.toggle('is-open', open);
      toggle?.setAttribute('aria-expanded', String(open));
      if (label) label.textContent = open ? 'Tutup' : 'Menu';
    };
    toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav?.classList.contains('is-open')) { setOpen(false); toggle?.focus(); }
    });
  </script>
</body>
</html>
